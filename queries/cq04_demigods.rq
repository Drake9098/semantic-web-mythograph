# CQ4 - Quali personaggi sono semidei, e chi è il genitore divino?
# Semidio = mortale con un genitore divino (classe definita): lo classifica il reasoner.
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX myth: <https://example.org/mythograph/ontology#>
PREFIX res:  <https://example.org/mythograph/resource/>
PREFIX g:    <https://example.org/mythograph/graph/>

SELECT ?fonte ?semidio ?genitoreDivino WHERE {
  GRAPH g:meta { ?vista myth:viewOf ?fonte }
  GRAPH ?vista {
    ?semidio a myth:Demigod ; myth:hasParent ?genitoreDivino .
    ?genitoreDivino a myth:Deity .
  }
}
ORDER BY ?semidio ?fonte
