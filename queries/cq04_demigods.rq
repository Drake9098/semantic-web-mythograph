# CQ4 — Quali personaggi sono semidei, e perché?
# Demigod è una classe DEFINITA (Human ⊓ ∃hasParent.Deity): nessun individuo
# è dichiarato semidio, li classifica il reasoner.
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX myth: <https://example.org/mythograph/ontology#>
PREFIX res:  <https://example.org/mythograph/resource/>
PREFIX g:    <https://example.org/mythograph/graph/>

SELECT ?fonte ?semidio ?genitoreDivino WHERE {
  GRAPH g:meta { ?vista myth:viewOf ?fonte }
  GRAPH ?vista {
    ?semidio a myth:Demigod ; myth:hasParent ?genitoreDivino .
    ?genitoreDivino a myth:Deity .
  }
}
ORDER BY ?semidio ?fonte
