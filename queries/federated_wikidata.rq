# Query federata: coordinate e pagina Wikipedia da Wikidata (SERVICE),
# collegate alle nostre risorse tramite owl:sameAs.
# {{WIKIDATA_IRIS}} viene sostituito da enrich.py; stare dentro il SERVICE evita una richiesta per risorsa.
PREFIX owl:    <http://www.w3.org/2002/07/owl#>
PREFIX wdt:    <http://www.wikidata.org/prop/direct/>
PREFIX schema: <http://schema.org/>

SELECT ?risorsa ?wd ?coord ?articolo WHERE {
  SERVICE <https://query.wikidata.org/sparql> {
    VALUES ?wd { {{WIKIDATA_IRIS}} }
    OPTIONAL { ?wd wdt:P625 ?coord . }
    OPTIONAL { ?articolo schema:about ?wd ;
                         schema:isPartOf <https://en.wikipedia.org/> . }
  }
  ?risorsa owl:sameAs ?wd .
}
