# Query FEDERATA (lezione 8, SERVICE): unisce il grafo locale con Wikidata.
#
# - il blocco SERVICE viene inviato all'endpoint pubblico di Wikidata, che
#   restituisce coordinate (P625) e pagina Wikipedia inglese delle entità;
# - il pattern fuori dal SERVICE gira sul NOSTRO grafo: per ogni entità di
#   Wikidata trova la nostra risorsa collegata con owl:sameAs (join locale).
# I dati restano dove sono: nessun dump di Wikidata viene scaricato.
#
# {{WIKIDATA_IRIS}} viene sostituito da mythograph.enrich con l'elenco dei QID.
# Metterlo DENTRO il SERVICE fa partire un'unica richiesta: altrimenti rdflib
# chiamerebbe Wikidata una volta per ogni risorsa.
PREFIX owl:    <http://www.w3.org/2002/07/owl#>
PREFIX wdt:    <http://www.wikidata.org/prop/direct/>
PREFIX schema: <http://schema.org/>

SELECT ?risorsa ?wd ?coord ?articolo WHERE {
  SERVICE <https://query.wikidata.org/sparql> {
    VALUES ?wd { {{WIKIDATA_IRIS}} }
    OPTIONAL { ?wd wdt:P625 ?coord . }
    OPTIONAL { ?articolo schema:about ?wd ;
                         schema:isPartOf <https://en.wikipedia.org/> . }
  }
  ?risorsa owl:sameAs ?wd .
}
