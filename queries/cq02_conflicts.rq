# CQ2 - Quali parentele sono contestate?
# Due casi: due fonti antiche danno padri (o madri) diversi; oppure Wikidata
# raccoglie più versioni per lo stesso personaggio.
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX myth: <https://example.org/mythograph/ontology#>
PREFIX res:  <https://example.org/mythograph/resource/>
PREFIX g:    <https://example.org/mythograph/graph/>

SELECT ?personaggio ?proprieta ?valore1 ?fonte1 ?valore2 ?fonte2 ?tipo WHERE {
  {
    VALUES ?proprieta { myth:hasFather myth:hasMother }
    GRAPH g:meta { ?v1 myth:viewOf ?fonte1 . ?v2 myth:viewOf ?fonte2 .
                   ?fonte1 myth:constrained true . ?fonte2 myth:constrained true . }
    GRAPH ?v1 { ?personaggio ?proprieta ?valore1 }
    GRAPH ?v2 { ?personaggio ?proprieta ?valore2 }
    FILTER(?valore1 != ?valore2 && STR(?fonte1) < STR(?fonte2))
    BIND("fonti diverse" AS ?tipo)
  } UNION {
    VALUES ?proprieta { myth:hasFather myth:hasMother }
    GRAPH g:wikidata { ?personaggio ?proprieta ?valore1 , ?valore2 }
    FILTER(STR(?valore1) < STR(?valore2))
    BIND(g:wikidata AS ?fonte1)
    BIND(g:wikidata AS ?fonte2)
    BIND("versioni diverse in Wikidata" AS ?tipo)
  }
}
ORDER BY ?personaggio ?proprieta
