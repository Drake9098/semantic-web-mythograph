# CQ6 - Quali eventi sono ambientati in un luogo o in un luogo che vi si trova? (default: Sicilia)
# locatedIn è transitiva; i luoghi mitici contano tramite identifiedWith.
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX myth: <https://example.org/mythograph/ontology#>
PREFIX res:  <https://example.org/mythograph/resource/>
PREFIX g:    <https://example.org/mythograph/graph/>

SELECT DISTINCT ?fonte ?evento ?luogo WHERE {
  GRAPH g:meta { ?vista myth:viewOf ?fonte }
  GRAPH ?vista {
    ?evento myth:setIn ?luogo .
    ?luogo myth:identifiedWith?/myth:locatedIn* ?target .
  }
}
ORDER BY ?fonte ?evento
