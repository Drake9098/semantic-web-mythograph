# CQ5 - Chi sono gli zii e le zie di un personaggio? (default: Eracle)
# Catena di proprietà hasParent + hasSibling, poi le regole SWRL usano il genere.
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX myth: <https://example.org/mythograph/ontology#>
PREFIX res:  <https://example.org/mythograph/resource/>
PREFIX g:    <https://example.org/mythograph/graph/>

SELECT ?fonte ?relazione ?parente WHERE {
  GRAPH g:meta { ?vista myth:viewOf ?fonte }
  GRAPH ?vista { ?target ?relazione ?parente }
  VALUES ?relazione { myth:hasUncle myth:hasAunt }
}
ORDER BY ?fonte ?relazione ?parente
