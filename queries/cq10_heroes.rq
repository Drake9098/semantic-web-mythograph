# CQ10 - Quali personaggi sono eroi, e quale mostro hanno ucciso?
# Eroe = mortale che ha ucciso un mostro (classe definita).
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX myth: <https://example.org/mythograph/ontology#>
PREFIX res:  <https://example.org/mythograph/resource/>
PREFIX g:    <https://example.org/mythograph/graph/>

SELECT DISTINCT ?eroe ?mostro WHERE {
  GRAPH g:meta { ?vista myth:viewOf g:wikidata }
  GRAPH ?vista {
    ?eroe a myth:Hero ; myth:killed ?mostro .
    ?mostro a myth:Monster .
  }
}
ORDER BY ?eroe
