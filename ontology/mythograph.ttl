# MythoGraph - schema (TBox): classi, proprietà, assiomi.
# I fatti stanno in data/shared.ttl e in data/sources/ (un file per fonte).

@prefix myth:    <https://example.org/mythograph/ontology#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .

<https://example.org/mythograph/ontology>
    a owl:Ontology ;
    dcterms:title "MythoGraph"@it ;
    dcterms:description "Ontologia delle genealogie e dei miti greci, con le fonti antiche (Esiodo, Omero, Apollodoro, Ovidio) modellate come named graph distinti."@it ;
    owl:versionInfo "0.1.0" .

# dichiarazioni richieste da HermiT per le proprietà di altri vocabolari
dcterms:creator a owl:ObjectProperty .
dcterms:source  a owl:AnnotationProperty .
dcterms:title   a owl:AnnotationProperty .
dcterms:description a owl:AnnotationProperty .
dcterms:date    a owl:AnnotationProperty .
skos:prefLabel  a owl:AnnotationProperty .

# ---------------------------------------------------------------- classi

myth:Character a owl:Class ;
    rdfs:label "Personaggio"@it, "Character"@en ;
    rdfs:comment "Qualunque figura che agisce nel mito: divinità, mortali, creature."@it .

# divinità
myth:Deity a owl:Class ; rdfs:subClassOf myth:Character ;
    rdfs:label "Divinità"@it, "Deity"@en, "θεός"@grc .

myth:Primordial a owl:Class ; rdfs:subClassOf myth:Deity ;
    rdfs:label "Divinità primordiale"@it, "Primordial deity"@en ;
    rdfs:comment "Le prime entità generate all'origine del cosmo (Caos, Gea, Urano…)."@it .

myth:Titan a owl:Class ; rdfs:subClassOf myth:Deity ;
    rdfs:label "Titano"@it, "Titan"@en, "Τιτάν"@grc .

myth:Olympian a owl:Class ; rdfs:subClassOf myth:Deity ;
    rdfs:label "Olimpico"@it, "Olympian"@en ;
    rdfs:comment "Le divinità che risiedono sull'Olimpo. Le liste canoniche dei dodici differiscono tra le fonti (Estia o Dioniso?), quindi la classe NON è chiusa con owl:oneOf."@it .

myth:MinorDeity a owl:Class ; rdfs:subClassOf myth:Deity ;
    rdfs:label "Divinità minore"@it, "Minor deity"@en .

myth:Nymph a owl:Class ; rdfs:subClassOf myth:MinorDeity ;
    rdfs:label "Ninfa"@it, "Nymph"@en, "νύμφη"@grc .

myth:Muse a owl:Class ; rdfs:subClassOf myth:MinorDeity ;
    rdfs:label "Musa"@it, "Muse"@en, "Μοῦσα"@grc .

# immortali / mortali
myth:Immortal a owl:Class ; rdfs:subClassOf myth:Character ;
    rdfs:label "Immortale"@it, "Immortal"@en, "ἀθάνατος"@grc ;
    rdfs:comment "Esseri che non possono morire: le divinità, ma anche mostri come Tifone."@it .

myth:Deity rdfs:subClassOf myth:Immortal .

myth:Mortal a owl:Class ; rdfs:subClassOf myth:Character ;
    rdfs:label "Mortale"@it, "Mortal"@en, "θνητός"@grc .

myth:Human a owl:Class ; rdfs:subClassOf myth:Mortal ;
    rdfs:label "Essere umano"@it, "Human"@en .

myth:Ruler a owl:Class ; rdfs:subClassOf myth:Human ;
    rdfs:label "Sovrano"@it, "Ruler"@en .

# creature
myth:Creature a owl:Class ; rdfs:subClassOf myth:Character ;
    rdfs:label "Creatura"@it, "Creature"@en .

myth:Monster a owl:Class ; rdfs:subClassOf myth:Creature ;
    rdfs:label "Mostro"@it, "Monster"@en .

myth:Cyclops a owl:Class ; rdfs:subClassOf myth:Creature ;
    rdfs:label "Ciclope"@it, "Cyclops"@en, "Κύκλωψ"@grc .

# genere (usato dal range di hasFather / hasMother)
myth:Male a owl:Class ; rdfs:subClassOf myth:Character ;
    rdfs:label "Maschile"@it, "Male"@en .
myth:Female a owl:Class ; rdfs:subClassOf myth:Character ;
    rdfs:label "Femminile"@it, "Female"@en .

# eventi
myth:Event a owl:Class ;
    rdfs:label "Evento mitico"@it, "Mythical event"@en .

myth:HeroicDeed a owl:Class ; rdfs:subClassOf myth:Event ;
    rdfs:label "Impresa eroica"@it, "Heroic deed"@en .

myth:Labour a owl:Class ; rdfs:subClassOf myth:HeroicDeed ;
    rdfs:label "Fatica"@it, "Labour"@en, "ἆθλος"@grc .

myth:War a owl:Class ; rdfs:subClassOf myth:Event ;
    rdfs:label "Guerra"@it, "War"@en .

myth:Birth a owl:Class ; rdfs:subClassOf myth:Event ;
    rdfs:label "Nascita"@it, "Birth"@en .

myth:Metamorphosis a owl:Class ; rdfs:subClassOf myth:Event ;
    rdfs:label "Metamorfosi"@it, "Metamorphosis"@en .

# luoghi
myth:Place a owl:Class ;
    rdfs:label "Luogo"@it, "Place"@en .

myth:RealPlace a owl:Class ; rdfs:subClassOf myth:Place ;
    rdfs:label "Luogo reale"@it, "Real place"@en ;
    rdfs:comment "Luogo geografico esistente (collegabile a Wikidata con coordinate)."@it .

myth:MythicalPlace a owl:Class ; rdfs:subClassOf myth:Place ;
    rdfs:label "Luogo mitico"@it, "Mythical place"@en ;
    rdfs:comment "Luogo che esiste solo nel racconto (Tartaro, Ade…)."@it .

# fonti
myth:LiteraryWork a owl:Class ;
    rdfs:label "Opera letteraria"@it, "Literary work"@en .

myth:Passage a owl:Class ;
    rdfs:label "Passo"@it, "Passage"@en ;
    rdfs:comment "Frammento di un'opera (libro e versi) che attesta un'affermazione, come i frammenti di OntoComedySources."@it .

myth:Author a owl:Class ;
    rdfs:label "Autore antico"@it, "Ancient author"@en .

# ambiti delle divinità
myth:Domain a owl:Class ; rdfs:subClassOf skos:Concept ;
    rdfs:label "Ambito"@it, "Domain"@en ;
    rdfs:comment "Ambito di competenza di una divinità (cielo, mare, oltretomba…)."@it .
skos:Concept a owl:Class .

# ----------------------------------------------------------- disgiunzioni
myth:Immortal owl:disjointWith myth:Mortal .

# copertura: ogni personaggio è immortale o mortale (serve HermiT, non RL)
myth:Character rdfs:subClassOf [ a owl:Class ; owl:unionOf ( myth:Immortal myth:Mortal ) ] .

myth:Male owl:disjointWith myth:Female .

myth:RealPlace owl:disjointWith myth:MythicalPlace .

[] a owl:AllDisjointClasses ;
   owl:members ( myth:Character myth:Event myth:Place myth:LiteraryWork myth:Passage myth:Author myth:Domain ) .

# -------------------------------------------------------------- parentela

myth:hasParent a owl:ObjectProperty ;
    rdfs:label "ha genitore"@it, "has parent"@en ;
    rdfs:domain myth:Character ; rdfs:range myth:Character ;
    rdfs:subPropertyOf myth:hasAncestor ;
    owl:inverseOf myth:hasChild .

myth:hasChild a owl:ObjectProperty ;
    rdfs:label "ha figlio/a"@it, "has child"@en ;
    rdfs:domain myth:Character ; rdfs:range myth:Character .

# funzionali: un solo padre e una sola madre per fonte.
# è questo che rende inconsistente la fusione delle fonti (Afrodite).
myth:hasFather a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "ha padre"@it, "has father"@en ;
    rdfs:subPropertyOf myth:hasParent ;
    rdfs:range myth:Male .

myth:hasMother a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "ha madre"@it, "has mother"@en ;
    rdfs:subPropertyOf myth:hasParent ;
    rdfs:range myth:Female .

myth:hasAncestor a owl:ObjectProperty, owl:TransitiveProperty ;
    rdfs:label "ha antenato"@it, "has ancestor"@en ;
    rdfs:domain myth:Character ; rdfs:range myth:Character ;
    owl:inverseOf myth:hasDescendant .

myth:hasDescendant a owl:ObjectProperty, owl:TransitiveProperty ;
    rdfs:label "ha discendente"@it, "has descendant"@en .

myth:hasSpouse a owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:label "ha coniuge"@it, "has spouse"@en ;
    rdfs:domain myth:Character ; rdfs:range myth:Character .

# niente catena hasParent o hasChild (ognuno sarebbe fratello di sé):
# la calcola la regola rules/08_sibling.rq
myth:hasSibling a owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:label "ha fratello/sorella"@it, "has sibling"@en ;
    rdfs:domain myth:Character ; rdfs:range myth:Character .

# zii: catena hasParent + hasSibling; zio/zia li distingue rules/10_uncle_aunt.rq
myth:hasParentSibling a owl:ObjectProperty ;
    rdfs:label "ha zio/zia"@it, "has parent's sibling"@en ;
    owl:propertyChainAxiom ( myth:hasParent myth:hasSibling ) .

myth:hasUncle a owl:ObjectProperty ;
    rdfs:label "ha zio"@it, "has uncle"@en ;
    rdfs:subPropertyOf myth:hasParentSibling .

myth:hasAunt a owl:ObjectProperty ;
    rdfs:label "ha zia"@it, "has aunt"@en ;
    rdfs:subPropertyOf myth:hasParentSibling .

# ------------------------------------------------ eventi, luoghi, altro

myth:killed a owl:ObjectProperty ;
    rdfs:label "uccise"@it, "killed"@en ;
    rdfs:domain myth:Character ; rdfs:range myth:Character ;
    owl:inverseOf myth:killedBy .

myth:killedBy a owl:ObjectProperty ;
    rdfs:label "ucciso da"@it, "killed by"@en .

myth:hasParticipant a owl:ObjectProperty ;
    rdfs:label "ha partecipante"@it, "has participant"@en ;
    rdfs:domain myth:Event ; rdfs:range myth:Character ;
    owl:inverseOf myth:participatesIn .

myth:participatesIn a owl:ObjectProperty ;
    rdfs:label "partecipa a"@it, "participates in"@en .

myth:hasAgent a owl:ObjectProperty ;
    rdfs:label "ha come agente"@it, "has agent"@en ;
    rdfs:subPropertyOf myth:hasParticipant .

myth:hasPatient a owl:ObjectProperty ;
    rdfs:label "ha come paziente"@it, "has patient"@en ;
    rdfs:subPropertyOf myth:hasParticipant .

myth:setIn a owl:ObjectProperty ;
    rdfs:label "ambientato in"@it, "set in"@en ;
    rdfs:domain myth:Event ; rdfs:range myth:Place .

myth:locatedIn a owl:ObjectProperty, owl:TransitiveProperty ;
    rdfs:label "si trova in"@it, "located in"@en ;
    rdfs:domain myth:Place ; rdfs:range myth:Place .

# es. Trinacria -> Sicilia (identificazione della tradizione, non sameAs)
myth:identifiedWith a owl:ObjectProperty ;
    rdfs:label "identificato con"@it, "identified with"@en ;
    rdfs:domain myth:MythicalPlace ; rdfs:range myth:RealPlace .

myth:residesIn a owl:ObjectProperty ;
    rdfs:label "risiede in"@it, "resides in"@en ;
    rdfs:domain myth:Character ; rdfs:range myth:Place .

myth:bornIn a owl:ObjectProperty ;
    rdfs:label "nato/a a"@it, "born in"@en ;
    rdfs:domain myth:Character ; rdfs:range myth:Place .

myth:rulesOver a owl:ObjectProperty ;
    rdfs:label "regna su"@it, "rules over"@en ;
    rdfs:domain myth:Character .

myth:hasDomain a owl:ObjectProperty ;
    rdfs:label "ha come ambito"@it, "has domain"@en ;
    rdfs:domain myth:Deity ; rdfs:range myth:Domain .

myth:transformedInto a owl:ObjectProperty ;
    rdfs:label "trasformato in"@it, "transformed into"@en ;
    rdfs:domain myth:Character .

myth:NaturalForm a owl:Class ;
    rdfs:label "Forma naturale"@it, "Natural form"@en ;
    rdfs:comment "Animale, pianta o elemento naturale in cui un personaggio viene trasformato (lupo, alloro…)."@it .

# volutamente non sameAs (fonderebbe tutto); sameAs solo nel grafo di Ovidio
myth:romanCounterpart a owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:label "corrispettivo romano"@it, "Roman counterpart"@en ;
    rdfs:domain myth:Deity ; rdfs:range myth:Deity .

# ------------------------------------------------------- fonti e passi

myth:attestedIn a owl:ObjectProperty ;
    rdfs:label "attestato in"@it, "attested in"@en ;
    rdfs:range myth:Passage ;
    rdfs:comment "Collega un'affermazione reificata (rdf:Statement) o un evento al passo dell'opera che lo riporta."@it .

myth:inWork a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "nell'opera"@it, "in work"@en ;
    rdfs:domain myth:Passage ; rdfs:range myth:LiteraryWork .

myth:locus a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "luogo del testo"@it, "locus"@en ;
    rdfs:domain myth:Passage ; rdfs:range xsd:string ;
    rdfs:comment "Riferimento al testo, es. 'vv. 188-206' o 'V 370-430'."@it .

myth:composedAround a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "composta intorno al"@it, "composed around"@en ;
    rdfs:domain myth:LiteraryWork ; rdfs:range xsd:integer ;
    rdfs:comment "Anno approssimativo di composizione (negativo = a.C.)."@it .

myth:sourceGraph a owl:AnnotationProperty ;
    rdfs:label "named graph della fonte"@it .

myth:versionNote a owl:AnnotationProperty ;
    rdfs:label "nota sulla versione"@it .

# le rdf:Statement non vengono passate a HermiT (vocabolario rdf: riservato in DL)

# ---------------------------------------- restrizioni e classi definite

# max 2 genitori
myth:Character rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty myth:hasParent ;
    owl:maxCardinality "2"^^xsd:nonNegativeInteger ] .

# gli immortali non possono essere uccisi (+ copertura: chi è ucciso è mortale)
myth:Immortal rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty myth:killedBy ;
    owl:maxCardinality "0"^^xsd:nonNegativeInteger ] .

# gli olimpici stanno sull'Olimpo
myth:Olympian rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty myth:residesIn ;
    owl:hasValue <https://example.org/mythograph/resource/MountOlympus> ] .

# ogni passo appartiene a un'opera
myth:Passage rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty myth:inWork ;
    owl:someValuesFrom myth:LiteraryWork ] .

# i genitori di un umano sono dei o umani
myth:Human rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty myth:hasParent ;
    owl:allValuesFrom [ a owl:Class ; owl:unionOf ( myth:Deity myth:Human ) ] ] .

# semidio = umano con almeno un genitore divino (nessuno è dichiarato tale)
myth:Demigod a owl:Class ;
    rdfs:label "Semidio"@it, "Demigod"@en, "ἡμίθεος"@grc ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            myth:Human
            [ a owl:Restriction ; owl:onProperty myth:hasParent ; owl:someValuesFrom myth:Deity ]
        ) ] .

# eroe = umano che partecipa a un'impresa o a una guerra
myth:Hero a owl:Class ;
    rdfs:label "Eroe"@it, "Hero"@en, "ἥρως"@grc ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            myth:Human
            [ a owl:Restriction ; owl:onProperty myth:participatesIn ;
              owl:someValuesFrom [ a owl:Class ; owl:unionOf ( myth:HeroicDeed myth:War ) ] ]
        ) ] .

# sovrano = umano che regna su un luogo
myth:Ruler owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        myth:Human
        [ a owl:Restriction ; owl:onProperty myth:rulesOver ; owl:someValuesFrom myth:Place ]
    ) ] .
