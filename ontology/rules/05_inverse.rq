# owl:inverseOf in entrambe le direzioni (lezione 11).
# Equivale ad asserire owl:inverseOf owl:inverseOf owl:inverseOf.
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX myth: <https://example.org/mythograph/ontology#>
CONSTRUCT { ?y ?q ?x . }
WHERE {
  { ?p owl:inverseOf ?q . } UNION { ?q owl:inverseOf ?p . }
  ?x ?p ?y .
}
