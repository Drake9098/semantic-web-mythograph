# Allineamento a CIDOC CRM, FaBiO, Dublin Core, FOAF.
# subClassOf e non equivalentClass: ogni nostro evento è un E5_Event, non viceversa.

@prefix myth:    <https://example.org/mythograph/ontology#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix crm:     <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix fabio:   <http://purl.org/spar/fabio/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .

# dichiarazioni richieste da HermiT
crm:E5_Event               a owl:Class ; rdfs:label "E5 Event"@en .
crm:E53_Place              a owl:Class ; rdfs:label "E53 Place"@en .
crm:E28_Conceptual_Object  a owl:Class ; rdfs:label "E28 Conceptual Object"@en .
crm:E33_Linguistic_Object  a owl:Class ; rdfs:label "E33 Linguistic Object"@en .
crm:E21_Person             a owl:Class ; rdfs:label "E21 Person"@en .
fabio:Work                 a owl:Class ; rdfs:label "FaBiO Work"@en .
foaf:Person                a owl:Class ; rdfs:label "FOAF Person"@en .
crm:P11_had_participant    a owl:ObjectProperty ; rdfs:label "P11 had participant"@en .
crm:P7_took_place_at       a owl:ObjectProperty ; rdfs:label "P7 took place at"@en .
crm:P89_falls_within       a owl:ObjectProperty ; rdfs:label "P89 falls within"@en .
dcterms:isPartOf           a owl:ObjectProperty ; rdfs:label "is part of"@en .

# classi
myth:Event        rdfs:subClassOf crm:E5_Event .             # eventi del mito
myth:Place        rdfs:subClassOf crm:E53_Place .            # luoghi (reali e mitici)
myth:LiteraryWork rdfs:subClassOf fabio:Work, crm:E33_Linguistic_Object .
myth:Passage      rdfs:subClassOf crm:E33_Linguistic_Object . # un frammento di testo
myth:Author       rdfs:subClassOf crm:E21_Person, foaf:Person .

# un personaggio mitico non è una persona storica (E21): uso E28 Conceptual Object
myth:Character    rdfs:subClassOf crm:E28_Conceptual_Object .


# proprietà
myth:hasParticipant rdfs:subPropertyOf crm:P11_had_participant .
myth:setIn          rdfs:subPropertyOf crm:P7_took_place_at .
myth:locatedIn      rdfs:subPropertyOf crm:P89_falls_within .
myth:inWork         rdfs:subPropertyOf dcterms:isPartOf .
