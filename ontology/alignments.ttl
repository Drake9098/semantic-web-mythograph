# MythoGraph - allineamento a CIDOC CRM, FaBiO, FOAF, Dublin Core.
# subClassOf e non equivalentClass: ogni nostro luogo è un E53_Place, non viceversa.

@prefix myth:    <https://example.org/mythograph/ontology#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix crm:     <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix fabio:   <http://purl.org/spar/fabio/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .

<https://example.org/mythograph/ontology/alignments>
    a owl:Ontology ;
    owl:imports <https://example.org/mythograph/ontology> ;
    rdfs:label "MythoGraph - allineamenti"@it .

crm:E53_Place              a owl:Class ; rdfs:label "E53 Place"@en .
crm:E28_Conceptual_Object  a owl:Class ; rdfs:label "E28 Conceptual Object"@en .
crm:E33_Linguistic_Object  a owl:Class ; rdfs:label "E33 Linguistic Object"@en .
crm:E21_Person             a owl:Class ; rdfs:label "E21 Person"@en .
crm:E74_Group              a owl:Class ; rdfs:label "E74 Group"@en .
fabio:Work                 a owl:Class ; rdfs:label "FaBiO Work"@en .
foaf:Person                a owl:Class ; rdfs:label "FOAF Person"@en .
dcterms:creator            a owl:ObjectProperty ; rdfs:label "creator"@en .

myth:Place        rdfs:subClassOf crm:E53_Place .
myth:LiteraryWork rdfs:subClassOf fabio:Work, crm:E33_Linguistic_Object .
myth:Author       rdfs:subClassOf crm:E21_Person, foaf:Person .
myth:Group        rdfs:subClassOf crm:E74_Group .

# un personaggio mitico non è una persona storica (E21): uso E28 Conceptual Object
myth:Character    rdfs:subClassOf crm:E28_Conceptual_Object .

myth:writtenBy    rdfs:subPropertyOf dcterms:creator .
