    geo1:long 22.3559 .

res:Arcadia_Q168786 rdfs:label "Arcadia"@en,
        "Arcadia"@it .

res:Argolis rdfs:label "Argolis"@en,
        "Argolide"@it .

res:Asterope_Q29655160 rdfs:label "Asterope"@en,
        "Asterope"@it .

res:Athens_Q13534153 rdfs:label "Athens"@en,
        "regno di Atene"@it .

res:Augur rdfs:label "augur"@en,
        "augure"@it ;
    myth:titleOver res:AncientRome .

res:Aulis rdfs:label "Aulis"@en,
        "Aulide"@it ;
