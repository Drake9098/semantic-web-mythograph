res:CephalusAndProcris rdfs:label "Cephalus and Procris"@en,
        "Cefalo e Procri"@it .

res:Chimera a myth:Character,
        myth:Creature ;
    rdfs:label "Χίμαιρα"@el,
        "chimera"@en,
        "Χίμαιρα"@grc,
        "chimera"@it,
        "Chimaera"@la ;
    myth:hasChild res:NemeanLion ;
    myth:hasFather res:Typhon ;
    myth:killedBy res:Bellerophon .

res:Coon a myth:Character,
        myth:Male ;
    rdfs:label "Κόωνας"@el,
        "Coön"@en,
