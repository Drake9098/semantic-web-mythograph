g:constraints {
    myth:hasFather a owl:FunctionalProperty .

    myth:hasMother a owl:FunctionalProperty .

    <https://example.org/mythograph/ontology/constraints> a owl:Ontology ;
        rdfs:label "MythoGraph - vincoli per fonte"@it ;
        rdfs:comment "Da importare solo quando si ragiona su una singola fonte."@it ;
        owl:imports <https://example.org/mythograph/ontology> .

    myth:Immortal rdfs:subClassOf _:nf3e36aaedc0f480b806159c889c113e8b2 .

    myth:Character rdfs:subClassOf _:nf3e36aaedc0f480b806159c889c113e8b1 .

    _:nf3e36aaedc0f480b806159c889c113e8b1 a owl:Restriction ;
        owl:maxCardinality "2"^^xsd:nonNegativeInteger ;
        owl:onProperty myth:hasParent .

    _:nf3e36aaedc0f480b806159c889c113e8b2 a owl:Restriction ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger ;
        owl:onProperty myth:killedBy .
}

