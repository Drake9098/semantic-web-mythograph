g:alignments {
    dcterms:isPartOf a owl:ObjectProperty ;
        rdfs:label "is part of"@en .

    crm:P11_had_participant a owl:ObjectProperty ;
        rdfs:label "P11 had participant"@en .

    crm:P7_took_place_at a owl:ObjectProperty ;
        rdfs:label "P7 took place at"@en .

    crm:P89_falls_within a owl:ObjectProperty ;
        rdfs:label "P89 falls within"@en .

    myth:locatedIn rdfs:subPropertyOf crm:P89_falls_within .

    myth:setIn rdfs:subPropertyOf crm:P7_took_place_at .

    myth:inWork rdfs:subPropertyOf dcterms:isPartOf .

    myth:hasParticipant rdfs:subPropertyOf crm:P11_had_participant .

    myth:Author rdfs:subClassOf crm:E21_Person,
            foaf:Person .

    crm:E21_Person a owl:Class ;
        rdfs:label "E21 Person"@en .

    foaf:Person a owl:Class ;
        rdfs:label "FOAF Person"@en .

    myth:LiteraryWork rdfs:subClassOf fabio:Work,
            crm:E33_Linguistic_Object .

    fabio:Work a owl:Class ;
        rdfs:label "FaBiO Work"@en .

    crm:E5_Event a owl:Class ;
        rdfs:label "E5 Event"@en .

    myth:Event rdfs:subClassOf crm:E5_Event .

    myth:Passage rdfs:subClassOf crm:E33_Linguistic_Object .

    crm:E33_Linguistic_Object a owl:Class ;
        rdfs:label "E33 Linguistic Object"@en .

    crm:E53_Place a owl:Class ;
        rdfs:label "E53 Place"@en .

    myth:Place rdfs:subClassOf crm:E53_Place .

    crm:E28_Conceptual_Object a owl:Class ;
        rdfs:label "E28 Conceptual Object"@en .

    myth:Character rdfs:subClassOf crm:E28_Conceptual_Object .
}

