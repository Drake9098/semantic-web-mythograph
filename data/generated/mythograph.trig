g:homer {
    res:Artemis myth:hasFather res:Zeus ;
        myth:hasMother res:Leto .

    res:BirthOfHeracles a myth:Birth ;
        rdfs:label "Hera delays the birth of Heracles"@en,
            "Era ritarda la nascita di Eracle"@it ;
        myth:attestedIn res:Il_XIX_95_133 ;
        myth:hasParticipant res:Alcmene,
            res:Hera,
            res:Heracles ;
        myth:setIn res:Thebes .

    res:BlindingOfPolyphemus a myth:HeroicDeed ;
        rdfs:label "Odysseus blinds Polyphemus"@en,
            "Odisseo acceca Polifemo"@it ;
        myth:attestedIn res:Od_IX_371_394 ;
        myth:hasAgent res:Odysseus ;
        myth:hasPatient res:Polyphemus ;
        myth:setIn res:LandOfCyclopes .

    res:CattleOfHelios a myth:Event ;
        rdfs:label "The cattle of Helios"@en,
            "I compagni di Odisseo uccidono le vacche del Sole"@it ;
        myth:attestedIn res:Od_XII_260_419 ;
        myth:hasParticipant res:Helios,
            res:Odysseus,
            res:Zeus ;
        myth:setIn res:Thrinacia .

    res:Dionysus myth:hasFather res:Zeus ;
        myth:hasMother res:Semele .

    res:FallOfHephaestus a myth:Event ;
        rdfs:label "Zeus hurls Hephaestus from Olympus"@en,
            "Zeus scaglia Efesto dall'Olimpo"@it ;
        myth:attestedIn res:Il_I_571_594 ;
        myth:hasAgent res:Zeus ;
        myth:hasPatient res:Hephaestus ;
        myth:setIn res:Lemnos .

    res:Hades myth:hasDomain res:UnderworldRealm ;
        myth:hasFather res:Cronus ;
        myth:hasMother res:Rhea ;
        myth:hasSpouse res:Persephone ;
        myth:rulesOver res:Underworld .

    res:Helen myth:hasFather res:Zeus ;
        myth:hasSpouse res:Menelaus .

    res:Hermes myth:hasFather res:Zeus ;
        myth:hasMother res:Maia .

    res:Il_IV_59_61 a myth:Passage ;
