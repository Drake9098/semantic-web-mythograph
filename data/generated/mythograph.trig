    res:Nereids a crm:E74_Group .

    res:Odyssey a fabio:Work,
            crm:E33_Linguistic_Object .

    res:TwelveOlympians a crm:E74_Group .

    res:Echidna a crm:E28_Conceptual_Object .

    res:Thetis a crm:E28_Conceptual_Object ;
        myth:hasAncestor res:Doris ;
        myth:hasMother res:Doris ;
        myth:hasParent res:Doris .

    res:Iliad a fabio:Work,
            crm:E33_Linguistic_Object .

    res:Eos a crm:E28_Conceptual_Object,
            myth:Immortal .

    res:Doris a crm:E28_Conceptual_Object,
            myth:Immortal,
            myth:MinorDeity,
            myth:Nymph ;
        myth:hasDescendant res:Thetis .

    res:Typhon a crm:E28_Conceptual_Object .
}

