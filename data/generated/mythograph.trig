        rdfs:label "has father"@en,
            "ha padre"@it ;
        rdfs:range myth:Male ;
        rdfs:subPropertyOf myth:hasParent .

    myth:hasMother a owl:FunctionalProperty,
            owl:ObjectProperty ;
        rdfs:label "has mother"@en,
            "ha madre"@it ;
        rdfs:range myth:Female ;
        rdfs:subPropertyOf myth:hasParent .

    myth:Birth a owl:Class ;
        rdfs:label "Birth"@en,
            "Nascita"@it ;
        rdfs:subClassOf myth:Event .

    myth:Demigod a owl:Class ;
        rdfs:label "Demigod"@en,
            "ἡμίθεος"@grc,
            "Semidio"@it ;
        owl:equivalentClass _:n79f1c05d85c84f17a7724fd077c1d61bb22 .

    myth:hasParent a owl:ObjectProperty ;
        rdfs:label "has parent"@en,
            "ha genitore"@it ;
        rdfs:domain myth:Character ;
        rdfs:range myth:Character ;
        rdfs:subPropertyOf myth:hasAncestor ;
        owl:inverseOf myth:hasChild .

    myth:HeroicDeed a owl:Class ;
        rdfs:label "Heroic deed"@en,
            "Impresa eroica"@it ;
        rdfs:subClassOf myth:Event .

