        ns1:body _:ne3c5cf40ca7c402eaffd5f975c7e2296b48 ;
        ns1:head _:ne3c5cf40ca7c402eaffd5f975c7e2296b51 ;
        myth:swrlText "killed(?x,?y) ^ hasDescendant(?x,?y) -> killedDescendant(?x,?y)" .

    _:ne3c5cf40ca7c402eaffd5f975c7e2296b52 a ns1:Imp ;
        rdfs:label "fratricidio"@it ;
        rdfs:comment "Killing one's sibling."@en,
