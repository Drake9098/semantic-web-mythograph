        ns1:body _:ne3c5cf40ca7c402eaffd5f975c7e2296b62 ;
        ns1:head _:ne3c5cf40ca7c402eaffd5f975c7e2296b65 ;
        myth:swrlText "killed(?x,?y) ^ hasSpouse(?x,?y) -> killedSpouse(?x,?y)" .

    _:ne3c5cf40ca7c402eaffd5f975c7e2296b66 a ns1:Imp ;
