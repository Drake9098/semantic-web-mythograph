            "Immortale"@it ;
        rdfs:comment "Esseri che non possono morire: le divinità, ma anche mostri come Tifone."@it ;
        rdfs:subClassOf _:n79f1c05d85c84f17a7724fd077c1d61bb15,
            myth:Character ;
        owl:disjointWith myth:Mortal .

    myth:Female a owl:Class ;
        rdfs:label "Female"@en,
            "Femminile"@it ;
