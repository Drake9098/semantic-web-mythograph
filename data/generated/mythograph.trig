        ns1:body _:ne3c5cf40ca7c402eaffd5f975c7e2296b55 ;
        ns1:head _:ne3c5cf40ca7c402eaffd5f975c7e2296b58 ;
        myth:swrlText "killed(?x,?y) ^ hasSibling(?x,?y) -> killedSibling(?x,?y)" .

    _:ne3c5cf40ca7c402eaffd5f975c7e2296b59 a ns1:Imp ;
        rdfs:label "uxoricidio"@it ;
