g:ontology {
    dcterms:creator a owl:ObjectProperty .

    dcterms:date a owl:AnnotationProperty .

    dcterms:description a owl:AnnotationProperty .

    dcterms:source a owl:AnnotationProperty .

    dcterms:title a owl:AnnotationProperty .

    skos:prefLabel a owl:AnnotationProperty .

    <https://example.org/mythograph/ontology> a owl:Ontology ;
        dcterms:description "Ontologia delle genealogie e dei miti greci, con le fonti antiche (Esiodo, Omero, Apollodoro, Ovidio) modellate come named graph distinti."@it ;
        dcterms:title "MythoGraph"@it ;
        owl:versionInfo "0.1.0" .

    myth:Muse a owl:Class ;
        rdfs:label "Muse"@en,
            "Μοῦσα"@grc,
            "Musa"@it ;
        rdfs:subClassOf myth:MinorDeity .

    myth:attestedIn a owl:ObjectProperty ;
        rdfs:label "attested in"@en,
            "attestato in"@it ;
        rdfs:comment "Collega un'affermazione reificata (rdf:Statement) o un evento al passo dell'opera che lo riporta."@it ;
        rdfs:range myth:Passage .

    myth:bornIn a owl:ObjectProperty ;
        rdfs:label "born in"@en,
            "nato/a a"@it ;
        rdfs:domain myth:Character ;
        rdfs:range myth:Place .

    myth:composedAround a owl:DatatypeProperty,
            owl:FunctionalProperty ;
        rdfs:label "composed around"@en,
            "composta intorno al"@it ;
        rdfs:comment "Anno approssimativo di composizione (negativo = a.C.)."@it ;
        rdfs:domain myth:LiteraryWork ;
        rdfs:range xsd:integer .

    myth:hasAgent a owl:ObjectProperty ;
        rdfs:label "has agent"@en,
            "ha come agente"@it ;
        rdfs:subPropertyOf myth:hasParticipant .

    myth:hasAunt a owl:ObjectProperty ;
        rdfs:label "has aunt"@en,
            "ha zia"@it ;
        rdfs:subPropertyOf myth:hasParentSibling .

    myth:hasDomain a owl:ObjectProperty ;
        rdfs:label "has domain"@en,
            "ha come ambito"@it ;
        rdfs:domain myth:Deity ;
        rdfs:range myth:Domain .

    myth:hasPatient a owl:ObjectProperty ;
        rdfs:label "has patient"@en,
            "ha come paziente"@it ;
        rdfs:subPropertyOf myth:hasParticipant .

    myth:hasSpouse a owl:ObjectProperty,
            owl:SymmetricProperty ;
        rdfs:label "has spouse"@en,
            "ha coniuge"@it ;
        rdfs:domain myth:Character ;
        rdfs:range myth:Character .

    myth:hasUncle a owl:ObjectProperty ;
        rdfs:label "has uncle"@en,
            "ha zio"@it ;
        rdfs:subPropertyOf myth:hasParentSibling .

    myth:identifiedWith a owl:ObjectProperty ;
        rdfs:label "identified with"@en,
            "identificato con"@it ;
        rdfs:domain myth:MythicalPlace ;
        rdfs:range myth:RealPlace .

    myth:locatedIn a owl:ObjectProperty,
            owl:TransitiveProperty ;
        rdfs:label "located in"@en,
            "si trova in"@it ;
        rdfs:domain myth:Place ;
        rdfs:range myth:Place .

    myth:locus a owl:DatatypeProperty,
            owl:FunctionalProperty ;
        rdfs:label "locus"@en,
            "luogo del testo"@it ;
        rdfs:comment "Riferimento al testo, es. 'vv. 188-206' o 'V 370-430'."@it ;
        rdfs:domain myth:Passage ;
        rdfs:range xsd:string .

    myth:romanCounterpart a owl:ObjectProperty,
            owl:SymmetricProperty ;
        rdfs:label "Roman counterpart"@en,
            "corrispettivo romano"@it ;
        rdfs:domain myth:Deity ;
        rdfs:range myth:Deity .

    myth:setIn a owl:ObjectProperty ;
        rdfs:label "set in"@en,
            "ambientato in"@it ;
        rdfs:domain myth:Event ;
        rdfs:range myth:Place .

    myth:sourceGraph a owl:AnnotationProperty ;
        rdfs:label "named graph della fonte"@it .

    myth:transformedInto a owl:ObjectProperty ;
        rdfs:label "transformed into"@en,
            "trasformato in"@it ;
        rdfs:domain myth:Character .

    myth:versionNote a owl:AnnotationProperty ;
        rdfs:label "nota sulla versione"@it .

    skos:Concept a owl:Class .

    myth:Ruler a owl:Class ;
        rdfs:label "Ruler"@en,
            "Sovrano"@it ;
        rdfs:subClassOf myth:Human ;
        owl:equivalentClass _:n79f1c05d85c84f17a7724fd077c1d61bb33 .

    myth:hasAncestor a owl:ObjectProperty,
            owl:TransitiveProperty ;
        rdfs:label "has ancestor"@en,
            "ha antenato"@it ;
        rdfs:domain myth:Character ;
        rdfs:range myth:Character ;
        owl:inverseOf myth:hasDescendant .

    myth:hasChild a owl:ObjectProperty ;
        rdfs:label "has child"@en,
            "ha figlio/a"@it ;
        rdfs:domain myth:Character ;
        rdfs:range myth:Character .

    myth:hasDescendant a owl:ObjectProperty,
            owl:TransitiveProperty ;
        rdfs:label "has descendant"@en,
            "ha discendente"@it .

    myth:hasSibling a owl:ObjectProperty,
            owl:SymmetricProperty ;
        rdfs:label "has sibling"@en,
            "ha fratello/sorella"@it ;
        rdfs:domain myth:Character ;
        rdfs:range myth:Character .

    myth:inWork a owl:FunctionalProperty,
            owl:ObjectProperty ;
        rdfs:label "in work"@en,
            "nell'opera"@it ;
        rdfs:domain myth:Passage ;
        rdfs:range myth:LiteraryWork .

    myth:killed a owl:ObjectProperty ;
        rdfs:label "killed"@en,
            "uccise"@it ;
        rdfs:domain myth:Character ;
        rdfs:range myth:Character ;
        owl:inverseOf myth:killedBy .

    myth:residesIn a owl:ObjectProperty ;
        rdfs:label "resides in"@en,
            "risiede in"@it ;
        rdfs:domain myth:Character ;
        rdfs:range myth:Place .

    myth:rulesOver a owl:ObjectProperty ;
        rdfs:label "rules over"@en,
            "regna su"@it ;
        rdfs:domain myth:Character .

    myth:hasParentSibling a owl:ObjectProperty ;
        rdfs:label "has parent's sibling"@en,
            "ha zio/zia"@it ;
        owl:propertyChainAxiom _:n79f1c05d85c84f17a7724fd077c1d61bb12 .

    myth:hasParticipant a owl:ObjectProperty ;
        rdfs:label "has participant"@en,
            "ha partecipante"@it ;
        rdfs:domain myth:Event ;
        rdfs:range myth:Character ;
        owl:inverseOf myth:participatesIn .

    myth:killedBy a owl:ObjectProperty ;
        rdfs:label "killed by"@en,
            "ucciso da"@it .

    myth:participatesIn a owl:ObjectProperty ;
        rdfs:label "participates in"@en,
            "partecipa a"@it .

    myth:Hero a owl:Class ;
        rdfs:label "Hero"@en,
            "ἥρως"@grc,
            "Eroe"@it ;
        owl:equivalentClass _:n79f1c05d85c84f17a7724fd077c1d61bb26 .

    myth:Metamorphosis a owl:Class ;
        rdfs:label "Metamorphosis"@en,
            "Metamorfosi"@it ;
        rdfs:subClassOf myth:Event .

    myth:Labour a owl:Class ;
        rdfs:label "Labour"@en,
            "ἆθλος"@grc,
            "Fatica"@it ;
        rdfs:subClassOf myth:HeroicDeed .

    myth:NaturalForm a owl:Class ;
        rdfs:label "Natural form"@en,
            "Forma naturale"@it ;
        rdfs:comment "Animale, pianta o elemento naturale in cui un personaggio viene trasformato (lupo, alloro…)."@it .

    myth:War a owl:Class ;
        rdfs:label "War"@en,
            "Guerra"@it ;
        rdfs:subClassOf myth:Event .

    myth:hasFather a owl:FunctionalProperty,
