g:rules {
    myth:swrlText a owl:AnnotationProperty ;
        rdfs:label "regola in forma leggibile"@it .

    <https://example.org/mythograph/ontology/rules> a owl:Ontology ;
        rdfs:label "MythoGraph - regole SWRL"@it ;
        rdfs:comment "Regole SWRL: genitori dal genere, fratelli, zii, delitti in famiglia, matrimoni tra consanguinei."@it ;
        owl:imports <https://example.org/mythograph/ontology> .

    <urn:swrl:var#a> a ns1:Variable .

    <urn:swrl:var#u> a ns1:Variable .

    <urn:swrl:var#p> a ns1:Variable .

    <urn:swrl:var#y> a ns1:Variable .

    <urn:swrl:var#x> a ns1:Variable .

    _:ne3c5cf40ca7c402eaffd5f975c7e2296b1 a ns1:Imp ;
        rdfs:label "padre"@it ;
        rdfs:comment "A male parent is the father."@en,
            "Un genitore maschio è il padre."@it ;
        ns1:body _:ne3c5cf40ca7c402eaffd5f975c7e2296b4 ;
        ns1:head _:ne3c5cf40ca7c402eaffd5f975c7e2296b7 ;
        myth:swrlText "hasParent(?x,?p) ^ Male(?p) -> hasFather(?x,?p)" .

    _:ne3c5cf40ca7c402eaffd5f975c7e2296b15 a ns1:Imp ;
        rdfs:label "fratelli"@it ;
        rdfs:comment "Two different characters sharing a parent are siblings."@en,
            "Due personaggi diversi con un genitore in comune sono fratelli."@it ;
        ns1:body _:ne3c5cf40ca7c402eaffd5f975c7e2296b19 ;
        ns1:head _:ne3c5cf40ca7c402eaffd5f975c7e2296b23 ;
        myth:swrlText "hasParent(?x,?p) ^ hasParent(?y,?p) ^ differentFrom(?x,?y) -> hasSibling(?x,?y)" .

    _:ne3c5cf40ca7c402eaffd5f975c7e2296b24 a ns1:Imp ;
        rdfs:label "zio"@it ;
        rdfs:comment "A parent's brother is an uncle."@en,
            "Il fratello di un genitore è lo zio."@it ;
        ns1:body _:ne3c5cf40ca7c402eaffd5f975c7e2296b27 ;
        ns1:head _:ne3c5cf40ca7c402eaffd5f975c7e2296b30 ;
        myth:swrlText "hasParentSibling(?x,?u) ^ Male(?u) -> hasUncle(?x,?u)" .

    _:ne3c5cf40ca7c402eaffd5f975c7e2296b31 a ns1:Imp ;
        rdfs:label "zia"@it ;
        rdfs:comment "A parent's sister is an aunt."@en,
            "La sorella di un genitore è la zia."@it ;
        ns1:body _:ne3c5cf40ca7c402eaffd5f975c7e2296b34 ;
        ns1:head _:ne3c5cf40ca7c402eaffd5f975c7e2296b37 ;
        myth:swrlText "hasParentSibling(?x,?a) ^ Female(?a) -> hasAunt(?x,?a)" .

    _:ne3c5cf40ca7c402eaffd5f975c7e2296b38 a ns1:Imp ;
        rdfs:label "parricidio"@it ;
        rdfs:comment "Killing one's ancestor is parricide."@en,
            "Chi uccide un proprio antenato commette parricidio."@it ;
        ns1:body _:ne3c5cf40ca7c402eaffd5f975c7e2296b41 ;
        ns1:head _:ne3c5cf40ca7c402eaffd5f975c7e2296b44 ;
        myth:swrlText "killed(?x,?y) ^ hasAncestor(?x,?y) -> killedAncestor(?x,?y)" .

    _:ne3c5cf40ca7c402eaffd5f975c7e2296b45 a ns1:Imp ;
        rdfs:label "figlicidio"@it ;
