###############################################################################
#  MythoGraph — entità condivise
#
#  Qui stanno le informazioni su cui le fonti NON sono in disaccordo:
#  - chi esiste (con le etichette in italiano, inglese, greco antico)
#  - il tipo "stabile" (divinità / umano / creatura, genere)
#  - luoghi, opere, autori, ambiti.
#  Tutte le PARENTELE e gli EVENTI stanno invece nei file delle singole fonti
#  (data/sources/*.ttl), perché è lì che le versioni divergono.
#  Le etichette con tag di lingua applicano la lezione 4 (letterali, @lang).
###############################################################################

@prefix :        <https://example.org/mythograph/resource/> .
@prefix myth:    <https://example.org/mythograph/ontology#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .

# ============================== DIVINITÀ PRIMORDIALI ========================
:Chaos     a myth:Primordial ; rdfs:label "Caos"@it, "Chaos"@en, "Χάος"@grc .
:Gaia      a myth:Primordial, myth:Female ; rdfs:label "Gea"@it, "Gaia"@en, "Γαῖα"@grc .
:Uranus    a myth:Primordial, myth:Male ; rdfs:label "Urano"@it, "Uranus"@en, "Οὐρανός"@grc .
:Tartarus  a myth:Primordial, myth:Male ; rdfs:label "Tartaro (divinità)"@it, "Tartarus (deity)"@en, "Τάρταρος"@grc .
:Eros      a myth:Deity, myth:Male ; rdfs:label "Eros"@it, "Eros"@en, "Ἔρως"@grc .
:Erebus    a myth:Primordial, myth:Male ; rdfs:label "Erebo"@it, "Erebus"@en, "Ἔρεβος"@grc .
:Nyx       a myth:Primordial, myth:Female ; rdfs:label "Notte"@it, "Nyx"@en, "Νύξ"@grc .
:Pontus    a myth:Primordial, myth:Male ; rdfs:label "Ponto"@it, "Pontus"@en, "Πόντος"@grc .

