# ============================== LUOGHI ======================================
# locatedIn è transitiva: Enna → Sicilia → Italia ⇒ Enna → Italia.
:Greece    a myth:RealPlace ; rdfs:label "Grecia"@it, "Greece"@en .
:Italy     a myth:RealPlace ; rdfs:label "Italia"@it, "Italy"@en .
:Anatolia  a myth:RealPlace ; rdfs:label "Anatolia"@it, "Anatolia"@en .
:MountOlympus a myth:RealPlace ; rdfs:label "Monte Olimpo"@it, "Mount Olympus"@en, "Ὄλυμπος"@grc ; myth:locatedIn :Greece .
:Crete     a myth:RealPlace ; rdfs:label "Creta"@it, "Crete"@en, "Κρήτη"@grc ; myth:locatedIn :Greece .
:Lyctus    a myth:RealPlace ; rdfs:label "Litto"@it, "Lyctus"@en, "Λύκτος"@grc ; myth:locatedIn :Crete .
:Cythera   a myth:RealPlace ; rdfs:label "Citera"@it, "Cythera"@en, "Κύθηρα"@grc ; myth:locatedIn :Greece .
:Cyprus    a myth:RealPlace ; rdfs:label "Cipro"@it, "Cyprus"@en, "Κύπρος"@grc .
:Lemnos    a myth:RealPlace ; rdfs:label "Lemno"@it, "Lemnos"@en, "Λῆμνος"@grc ; myth:locatedIn :Greece .
:Ithaca    a myth:RealPlace ; rdfs:label "Itaca"@it, "Ithaca"@en, "Ἰθάκη"@grc ; myth:locatedIn :Greece .
:Thebes    a myth:RealPlace ; rdfs:label "Tebe"@it, "Thebes"@en, "Θῆβαι"@grc ; myth:locatedIn :Greece .
:Nemea     a myth:RealPlace ; rdfs:label "Nemea"@it, "Nemea"@en, "Νεμέα"@grc ; myth:locatedIn :Greece .
:Lerna     a myth:RealPlace ; rdfs:label "Lerna"@it, "Lerna"@en, "Λέρνη"@grc ; myth:locatedIn :Greece .
:Delphi    a myth:RealPlace ; rdfs:label "Delfi"@it, "Delphi"@en, "Δελφοί"@grc ; myth:locatedIn :Greece .
:Troy      a myth:RealPlace ; rdfs:label "Troia"@it, "Troy"@en, "Ἴλιος"@grc ; myth:locatedIn :Anatolia .
:Lycia     a myth:RealPlace ; rdfs:label "Licia"@it, "Lycia"@en, "Λυκία"@grc ; myth:locatedIn :Anatolia .
:Sicily    a myth:RealPlace ; rdfs:label "Sicilia"@it, "Sicily"@en, "Σικελία"@grc ; myth:locatedIn :Italy .
:Enna      a myth:RealPlace ; rdfs:label "Enna"@it, "Enna"@en, "Ἔννα"@grc ; myth:locatedIn :Sicily .
:Etna      a myth:RealPlace ; rdfs:label "Etna"@it, "Mount Etna"@en, "Αἴτνη"@grc ; myth:locatedIn :Sicily .
:StraitOfMessina a myth:RealPlace ; rdfs:label "Stretto di Messina"@it, "Strait of Messina"@en ; myth:locatedIn :Sicily .

:TartarusPlace a myth:MythicalPlace ; rdfs:label "Tartaro (luogo)"@it, "Tartarus (place)"@en .
:Underworld a myth:MythicalPlace ; rdfs:label "Oltretomba (Ade)"@it, "Underworld"@en .
:Erytheia  a myth:MythicalPlace ; rdfs:label "Erizia"@it, "Erytheia"@en, "Ἐρύθεια"@grc .
:Thrinacia a myth:MythicalPlace ; rdfs:label "Trinacria"@it, "Thrinacia"@en, "Θρινακίη"@grc ;
           myth:identifiedWith :Sicily .
:LandOfCyclopes a myth:MythicalPlace ; rdfs:label "Terra dei Ciclopi"@it, "Land of the Cyclopes"@en ;
           myth:identifiedWith :Sicily .
:StraitOfScylla a myth:MythicalPlace ; rdfs:label "Stretto di Scilla e Cariddi"@it, "Strait of Scylla and Charybdis"@en ;
           myth:identifiedWith :StraitOfMessina .

# ============================== AMBITI (SKOS) ================================
:Sky        a myth:Domain ; skos:prefLabel "Cielo"@it, "Sky"@en .
:Sea        a myth:Domain ; skos:prefLabel "Mare"@it, "Sea"@en .
:UnderworldRealm a myth:Domain ; skos:prefLabel "Regno dei morti"@it, "Realm of the dead"@en .
:Love       a myth:Domain ; skos:prefLabel "Amore"@it, "Love"@en .
:WarDomain  a myth:Domain ; skos:prefLabel "Guerra"@it, "War"@en .
:Wisdom     a myth:Domain ; skos:prefLabel "Sapienza"@it, "Wisdom"@en .
:Forge      a myth:Domain ; skos:prefLabel "Fuoco e metallurgia"@it, "Fire and metalwork"@en .
:Harvest    a myth:Domain ; skos:prefLabel "Agricoltura"@it, "Agriculture"@en .
:Wine       a myth:Domain ; skos:prefLabel "Vino"@it, "Wine"@en .

:Aphrodite  myth:hasDomain :Love .
:Ares       myth:hasDomain :WarDomain .
:Athena     myth:hasDomain :Wisdom .
:Hephaestus myth:hasDomain :Forge .
:Demeter    myth:hasDomain :Harvest .
:Dionysus   myth:hasDomain :Wine .

# ============================== OPERE E AUTORI (Dublin Core) ================
:Hesiod a myth:Author ; rdfs:label "Esiodo"@it, "Hesiod"@en, "Ἡσίοδος"@grc .
:Homer  a myth:Author ; rdfs:label "Omero"@it, "Homer"@en, "Ὅμηρος"@grc .
:Apollodorus a myth:Author ; rdfs:label "Pseudo-Apollodoro"@it, "Pseudo-Apollodorus"@en .
:Ovid   a myth:Author ; rdfs:label "Ovidio"@it, "Ovid"@en, "Ovidius"@la .

:Theogony a myth:LiteraryWork ; rdfs:label "Teogonia"@it, "Theogony"@en, "Θεογονία"@grc ;
    dcterms:creator :Hesiod ; myth:composedAround -700 ;
    myth:sourceGraph <https://example.org/mythograph/graph/hesiod> .
:Iliad a myth:LiteraryWork ; rdfs:label "Iliade"@it, "Iliad"@en, "Ἰλιάς"@grc ;
    dcterms:creator :Homer ; myth:composedAround -750 ;
    myth:sourceGraph <https://example.org/mythograph/graph/homer> .
:Odyssey a myth:LiteraryWork ; rdfs:label "Odissea"@it, "Odyssey"@en, "Ὀδύσσεια"@grc ;
    dcterms:creator :Homer ; myth:composedAround -725 ;
    myth:sourceGraph <https://example.org/mythograph/graph/homer> .
:Bibliotheca a myth:LiteraryWork ; rdfs:label "Biblioteca"@it, "Library"@en, "Βιβλιοθήκη"@grc ;
    dcterms:creator :Apollodorus ; myth:composedAround 100 ;
    myth:sourceGraph <https://example.org/mythograph/graph/apollodorus> .
:Metamorphoses a myth:LiteraryWork ; rdfs:label "Metamorfosi"@it, "Metamorphoses"@en, "Metamorphoses"@la ;
    dcterms:creator :Ovid ; myth:composedAround 8 ;
    myth:sourceGraph <https://example.org/mythograph/graph/ovid> .

# ============================== DIVINITÀ ROMANE ==============================
# Ovidio racconta gli stessi miti con i nomi latini. Qui le divinità romane sono
# risorse DISTINTE, collegate alle greche da myth:romanCounterpart (relazione
# "debole", vera per tutte le fonti). Solo nel grafo di Ovidio, che le identifica
# esplicitamente con quelle greche, si asserisce owl:sameAs (vedi ovid.ttl).
:Jupiter    a myth:Deity, myth:Male ; rdfs:label "Giove"@it, "Jupiter"@en, "Iuppiter"@la ; myth:romanCounterpart :Zeus .
:Neptune    a myth:Deity, myth:Male ; rdfs:label "Nettuno"@it, "Neptune"@en, "Neptunus"@la ; myth:romanCounterpart :Poseidon .
:Ceres      a myth:Deity, myth:Female ; rdfs:label "Cerere"@it, "Ceres"@en, "Ceres"@la ; myth:romanCounterpart :Demeter .
:Minerva    a myth:Deity, myth:Female ; rdfs:label "Minerva"@it, "Minerva"@en, "Minerva"@la ; myth:romanCounterpart :Athena .
:Diana      a myth:Deity, myth:Female ; rdfs:label "Diana"@it, "Diana"@en, "Diana"@la ; myth:romanCounterpart :Artemis .
:Mars       a myth:Deity, myth:Male ; rdfs:label "Marte"@it, "Mars"@en, "Mars"@la ; myth:romanCounterpart :Ares .
