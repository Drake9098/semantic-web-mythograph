###############################################################################
#  Fonte: OVIDIO, Metamorfosi (8 d.C.)
#  Named graph: <https://example.org/mythograph/graph/ovid>
#
#  Ovidio racconta in latino i miti greci, con i nomi romani (Giove, Venere,
#  Cupido…). Qui usiamo le risorse romane, e poi dichiariamo l'identificazione
#  che Ovidio stesso fa: Venere = Afrodite, Giove = Zeus…
#
#  SCELTA DI MODELLAZIONE (conciliazione dei termini, lezione 10):
#  - in shared.ttl le figure romane e greche sono collegate solo da
#    myth:romanCounterpart (relazione debole, simmetrica);
#  - QUI, e solo qui, si asserisce owl:sameAs. Il named graph limita la
#    portata dell'identità: in Esiodo e Omero Giove e Zeus restano distinti.
#    Dentro la versione di Ovidio il reasoner copia ogni fatto su Venere anche
#    su Afrodite, così le query sulla figura greca trovano anche Ovidio.
#  Riferimenti: libro in numeri romani + versi (es. "V 385-395").
###############################################################################

@prefix :        <https://example.org/mythograph/resource/> .
@prefix myth:    <https://example.org/mythograph/ontology#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

# ============================== IDENTIFICAZIONI (interpretatio romana) ======
:Jupiter    owl:sameAs :Zeus .
:Neptune    owl:sameAs :Poseidon .
:Ceres      owl:sameAs :Demeter .
:Minerva    owl:sameAs :Athena .
:Mars       owl:sameAs :Ares .
:Venus      owl:sameAs :Aphrodite .
:Vulcan     owl:sameAs :Hephaestus .
:Dis        owl:sameAs :Hades .
:Proserpina owl:sameAs :Persephone .
:Cupid      owl:sameAs :Eros .
:Sol        owl:sameAs :Helios .

# ============================== PASSI CITATI ================================
:Met_I_163_243   a myth:Passage ; myth:inWork :Metamorphoses ; myth:locus "I 163-243" ; rdfs:label "Metamorfosi, I 163-243"@it .
:Met_I_452_567   a myth:Passage ; myth:inWork :Metamorphoses ; myth:locus "I 452-567" ; rdfs:label "Metamorfosi, I 452-567"@it .
:Met_I_750_II_328 a myth:Passage ; myth:inWork :Metamorphoses ; myth:locus "I 750 - II 328" ; rdfs:label "Metamorfosi, I 750 - II 328"@it .
:Met_IV_171_189  a myth:Passage ; myth:inWork :Metamorphoses ; myth:locus "IV 171-189" ; rdfs:label "Metamorfosi, IV 171-189"@it .
:Met_IV_765_803  a myth:Passage ; myth:inWork :Metamorphoses ; myth:locus "IV 765-803" ; rdfs:label "Metamorfosi, IV 765-803"@it .
:Met_V_346_358   a myth:Passage ; myth:inWork :Metamorphoses ; myth:locus "V 346-358" ; rdfs:label "Metamorfosi, V 346-358"@it .
:Met_V_359_395   a myth:Passage ; myth:inWork :Metamorphoses ; myth:locus "V 359-395" ; rdfs:label "Metamorfosi, V 359-395"@it .
:Met_V_438_571   a myth:Passage ; myth:inWork :Metamorphoses ; myth:locus "V 438-571" ; rdfs:label "Metamorfosi, V 438-571"@it .
:Met_XIII_738_897 a myth:Passage ; myth:inWork :Metamorphoses ; myth:locus "XIII 738-897" ; rdfs:label "Metamorfosi, XIII 738-897"@it .
:Met_XIV_1_74    a myth:Passage ; myth:inWork :Metamorphoses ; myth:locus "XIV 1-74" ; rdfs:label "Metamorfosi, XIV 1-74"@it .

# ============================== LICAONE (I 163-243) ==========================
:Lycaon myth:rulesOver :Arcadia ; myth:transformedInto :Wolf .
:MetamorphosisOfLycaon a myth:Metamorphosis ;
    rdfs:label "Giove trasforma Licaone in lupo"@it, "Jupiter turns Lycaon into a wolf"@en ;
    myth:hasAgent :Jupiter ; myth:hasPatient :Lycaon ; myth:setIn :Arcadia ;
    myth:attestedIn :Met_I_163_243 .

# ============================== APOLLO E DAFNE (I 452-567) ===================
:Daphne myth:hasFather :Peneus ; myth:transformedInto :LaurelTree .
:ApolloAndDaphne a myth:Metamorphosis ;
    rdfs:label "Dafne, inseguita da Apollo, diventa alloro"@it, "Daphne becomes a laurel"@en ;
    myth:hasAgent :Cupid ; myth:hasParticipant :Apollo ; myth:hasPatient :Daphne ;
    myth:attestedIn :Met_I_452_567 .

# ============================== FETONTE (I 750 - II 328) =====================
:Phaethon myth:hasFather :Sol ; myth:hasMother :Clymene .
:Jupiter  myth:killed :Phaethon .                      # col fulmine (II 304-324)
:FallOfPhaethon a myth:Event ;
    rdfs:label "Giove fulmina Fetonte sul carro del Sole"@it, "Jupiter strikes down Phaethon"@en ;
    myth:hasAgent :Jupiter ; myth:hasPatient :Phaethon ; myth:hasParticipant :Sol ;
    myth:attestedIn :Met_I_750_II_328 .

# ============================== VENERE, MARTE, VULCANO (IV 171-189) ==========
:Venus myth:hasSpouse :Vulcan .
:VenusAndMars a myth:Event ;
    rdfs:label "Il Sole svela a Vulcano l'adulterio di Venere e Marte"@it, "Venus and Mars caught by Vulcan"@en ;
    myth:hasParticipant :Venus, :Mars, :Vulcan, :Sol ;
    myth:attestedIn :Met_IV_171_189 .

# ============================== MEDUSA (IV 765-803) ==========================
# Versione ovidiana: Medusa era una fanciulla bellissima; dopo che Nettuno la
# violò nel tempio di Minerva, la dea le mutò i capelli in serpenti.
# (In Esiodo è una Gorgone fin dalla nascita, figlia di Forco e Ceto.)
:MetamorphosisOfMedusa a myth:Metamorphosis ;
    rdfs:label "Minerva muta i capelli di Medusa in serpenti"@it, "Minerva transforms Medusa"@en ;
    myth:hasAgent :Minerva ; myth:hasPatient :Medusa ; myth:hasParticipant :Neptune ;
    myth:attestedIn :Met_IV_765_803 .
:Perseus myth:killed :Medusa .
:claim_ovid_medusa a rdf:Statement ;
    rdf:subject :Medusa ; rdf:predicate rdf:type ; rdf:object myth:Monster ;
    myth:attestedIn :Met_IV_765_803 ;
    myth:versionNote "Per Ovidio Medusa nasce fanciulla e diventa mostro per punizione di Minerva; per Esiodo è Gorgone dalla nascita."@it .

# ============================== TIFEO SOTTO LA SICILIA (V 346-358) ===========
# La Sicilia (Trinacria) schiaccia il gigante: la destra sotto il Peloro, la
# sinistra sotto il Pachino, le gambe sotto il Lilibeo, la testa sotto l'Etna.
:TyphonUnderEtna a myth:Event ;
    rdfs:label "Tifeo imprigionato sotto la Sicilia, con l'Etna sul capo"@it, "Typhoeus buried under Sicily"@en ;
    myth:hasPatient :Typhon ; myth:setIn :Etna ;
    myth:attestedIn :Met_V_346_358 .

# ============================== IL RATTO DI PROSERPINA (V 359-571) ===========
:Cupid      myth:hasMother :Venus .                       # Venere lo chiama "figlio" (V 363-366)
:Proserpina myth:hasFather :Jupiter ; myth:hasMother :Ceres .   # V 514-522
:Dis        myth:hasSpouse :Proserpina .

:CupidStrikesDis a myth:Event ;
    rdfs:label "Venere ordina a Cupido di colpire Dite"@it, "Cupid strikes Dis"@en ;
    myth:hasAgent :Cupid ; myth:hasPatient :Dis ; myth:hasParticipant :Venus ;
    myth:setIn :Sicily ;
    myth:attestedIn :Met_V_359_395 .

:AbductionOfProserpina a myth:Event ;
    rdfs:label "Dite rapisce Proserpina presso il lago di Pergusa"@it, "Dis abducts Proserpina"@en ;
    myth:hasAgent :Dis ; myth:hasPatient :Proserpina ;
    myth:setIn :LakePergus ;
    myth:attestedIn :Met_V_359_395 .

:CeresSearch a myth:Event ;
    rdfs:label "Cerere cerca la figlia; Giove la divide tra madre e sposo"@it, "Ceres searches for her daughter"@en ;
    myth:hasParticipant :Ceres, :Jupiter, :Proserpina, :Dis ;
    myth:setIn :Sicily ;
    myth:attestedIn :Met_V_438_571 .

# Cupido figlio di Venere contro Eros primordiale senza genitori (Esiodo).
:claim_ovid_cupid_mother a rdf:Statement ;
    rdf:subject :Cupid ; rdf:predicate myth:hasMother ; rdf:object :Venus ;
    myth:attestedIn :Met_V_359_395 .

# ============================== ACI E GALATEA (XIII 738-897) =================
:Acis    myth:hasFather :Faunus ; myth:hasMother :Symaethis ;    # XIII 750
         myth:transformedInto :AcisRiver .
:Galatea myth:hasFather :Nereus .                                 # una Nereide
:Polyphemus myth:hasFather :Neptune ;                             # XIII 854-858
            myth:killed :Acis .                                   # con un masso, XIII 882-884

:AcisAndGalatea a myth:Metamorphosis ;
    rdfs:label "Polifemo uccide Aci, che diventa fiume ai piedi dell'Etna"@it, "Polyphemus kills Acis, who becomes a river"@en ;
    myth:hasAgent :Polyphemus ; myth:hasPatient :Acis ; myth:hasParticipant :Galatea ;
    myth:setIn :Etna ;
    myth:attestedIn :Met_XIII_738_897 .

# ============================== SCILLA (XIV 1-74) ============================
# Per Ovidio Scilla era una fanciulla, mutata in mostro da Circe per gelosia.
:Circe myth:hasFather :Sol .
:MetamorphosisOfScylla a myth:Metamorphosis ;
    rdfs:label "Circe trasforma Scilla in mostro"@it, "Circe transforms Scylla"@en ;
    myth:hasAgent :Circe ; myth:hasPatient :Scylla ;
    myth:setIn :StraitOfMessina ;
    myth:attestedIn :Met_XIV_1_74 .
