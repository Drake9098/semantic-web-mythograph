# Omero, Iliade e Odissea -> grafo g:homer

@prefix :        <https://example.org/mythograph/resource/> .
@prefix myth:    <https://example.org/mythograph/ontology#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

# passi citati
:Il_I_1_10      a myth:Passage ; myth:inWork :Iliad ; myth:locus "I 1-10" ; rdfs:label "Iliade, I 1-10"@it .
:Il_I_351_360   a myth:Passage ; myth:inWork :Iliad ; myth:locus "I 351-360" ; rdfs:label "Iliade, I 351-360"@it .
:Il_I_571_594   a myth:Passage ; myth:inWork :Iliad ; myth:locus "I 571-594" ; rdfs:label "Iliade, I 571-594"@it .
:Il_IV_59_61    a myth:Passage ; myth:inWork :Iliad ; myth:locus "IV 59-61" ; rdfs:label "Iliade, IV 59-61"@it .
:Il_V_370_430   a myth:Passage ; myth:inWork :Iliad ; myth:locus "V 370-430" ; rdfs:label "Iliade, V 370-430"@it .
:Il_V_875_896   a myth:Passage ; myth:inWork :Iliad ; myth:locus "V 875-896" ; rdfs:label "Iliade, V 875-896"@it .
:Il_VI_198_199  a myth:Passage ; myth:inWork :Iliad ; myth:locus "VI 198-199" ; rdfs:label "Iliade, VI 198-199"@it .
:Il_VI_394_502  a myth:Passage ; myth:inWork :Iliad ; myth:locus "VI 394-502" ; rdfs:label "Iliade, VI 394-502"@it .
:Il_XIV_200_204 a myth:Passage ; myth:inWork :Iliad ; myth:locus "XIV 200-204" ; rdfs:label "Iliade, XIV 200-204"@it .
:Il_XIV_317_327 a myth:Passage ; myth:inWork :Iliad ; myth:locus "XIV 317-327" ; rdfs:label "Iliade, XIV 317-327"@it .
:Il_XV_187_193  a myth:Passage ; myth:inWork :Iliad ; myth:locus "XV 187-193" ; rdfs:label "Iliade, XV 187-193"@it .
:Il_XVI_431_505 a myth:Passage ; myth:inWork :Iliad ; myth:locus "XVI 431-505" ; rdfs:label "Iliade, XVI 431-505"@it .
:Il_XVI_818_857 a myth:Passage ; myth:inWork :Iliad ; myth:locus "XVI 818-857" ; rdfs:label "Iliade, XVI 818-857"@it .
:Il_XVIII_382_383 a myth:Passage ; myth:inWork :Iliad ; myth:locus "XVIII 382-383" ; rdfs:label "Iliade, XVIII 382-383"@it .
:Il_XIX_95_133  a myth:Passage ; myth:inWork :Iliad ; myth:locus "XIX 95-133" ; rdfs:label "Iliade, XIX 95-133"@it .
:Il_XXI_184_191 a myth:Passage ; myth:inWork :Iliad ; myth:locus "XXI 184-191" ; rdfs:label "Iliade, XXI 184-191"@it .
:Il_XXI_497_506 a myth:Passage ; myth:inWork :Iliad ; myth:locus "XXI 497-506" ; rdfs:label "Iliade, XXI 497-506"@it .
:Il_XXII_326_363 a myth:Passage ; myth:inWork :Iliad ; myth:locus "XXII 326-363" ; rdfs:label "Iliade, XXII 326-363"@it .
:Od_I_68_73     a myth:Passage ; myth:inWork :Odyssey ; myth:locus "I 68-73" ; rdfs:label "Odissea, I 68-73"@it .
:Od_VIII_266_366 a myth:Passage ; myth:inWork :Odyssey ; myth:locus "VIII 266-366" ; rdfs:label "Odissea, VIII 266-366"@it .
:Od_IX_371_394  a myth:Passage ; myth:inWork :Odyssey ; myth:locus "IX 371-394" ; rdfs:label "Odissea, IX 371-394"@it .
:Od_XI_217      a myth:Passage ; myth:inWork :Odyssey ; myth:locus "XI 217" ; rdfs:label "Odissea, XI 217"@it .
:Od_XI_601_604  a myth:Passage ; myth:inWork :Odyssey ; myth:locus "XI 601-604" ; rdfs:label "Odissea, XI 601-604"@it .
:Od_XII_234_259 a myth:Passage ; myth:inWork :Odyssey ; myth:locus "XII 234-259" ; rdfs:label "Odissea, XII 234-259"@it .
:Od_XII_260_419 a myth:Passage ; myth:inWork :Odyssey ; myth:locus "XII 260-419" ; rdfs:label "Odissea, XII 260-419"@it .
:Od_XIV_435     a myth:Passage ; myth:inWork :Odyssey ; myth:locus "XIV 435" ; rdfs:label "Odissea, XIV 435"@it .

# i figli di crono e rea
# Il. XV 187-193: Zeus, Poseidone e Ade figli di Crono e Rea; cielo, mare, inferi
:Zeus     myth:hasFather :Cronus ; myth:hasMother :Rhea ; myth:hasDomain :Sky .
:Poseidon myth:hasFather :Cronus ; myth:hasMother :Rhea ; myth:hasDomain :Sea .
:Hades    myth:hasFather :Cronus ; myth:hasMother :Rhea ; myth:hasDomain :UnderworldRealm ;
          myth:rulesOver :Underworld .
:Hera     myth:hasFather :Cronus ; myth:hasMother :Rhea .        # Il. IV 59; XIV 203-204

# Il. XIV 201: per Omero l'origine degli dei è Oceano
:Oceanus myth:versionNote "Per Omero, Oceano è «origine degli dèi» e Teti (titanide) la «madre» (Il. XIV 201): una cosmogonia diversa da quella di Esiodo, che parte da Caos."@it .

:Zeus myth:hasSpouse :Hera .                                     # "sorella e sposa", Il. XVI 432

# afrodite (il. v 370-430)
# figlia di Zeus e Dione (in Esiodo: Urano, nessuna madre)
:Aphrodite myth:hasFather :Zeus ; myth:hasMother :Dione .

:claim_hom_aphrodite_father a rdf:Statement ;
    rdf:subject :Aphrodite ; rdf:predicate myth:hasFather ; rdf:object :Zeus ;
    myth:attestedIn :Il_V_370_430 .
:claim_hom_aphrodite_mother a rdf:Statement ;
    rdf:subject :Aphrodite ; rdf:predicate myth:hasMother ; rdf:object :Dione ;
    myth:attestedIn :Il_V_370_430 .

# efesto
# qui ha un padre, Zeus, che lo scaglia a Lemno (in Esiodo nessun padre)
:Hephaestus myth:hasFather :Zeus ; myth:hasMother :Hera .
:claim_hom_hephaestus_father a rdf:Statement ;
    rdf:subject :Hephaestus ; rdf:predicate myth:hasFather ; rdf:object :Zeus ;
    myth:attestedIn :Il_I_571_594 .

:FallOfHephaestus a myth:Event ;
    rdfs:label "Zeus scaglia Efesto dall'Olimpo"@it, "Zeus hurls Hephaestus from Olympus"@en ;
    myth:hasAgent :Zeus ; myth:hasPatient :Hephaestus ; myth:setIn :Lemnos ;
    myth:attestedIn :Il_I_571_594 .

# sposa: Charis nell'Iliade (XVIII 382-383), Afrodite nell'Odissea (VIII 266-366)
:Hephaestus myth:hasSpouse :Charis, :Aphrodite .

# altri figli di zeus
:Athena   myth:hasFather :Zeus .                                 # Il. V 875-880 (Zeus la generò da solo)
:Apollo   myth:hasFather :Zeus ; myth:hasMother :Leto .          # Il. I 9
:Artemis  myth:hasFather :Zeus ; myth:hasMother :Leto .          # Il. XXI 497-506
:Ares     myth:hasFather :Zeus ; myth:hasMother :Hera .          # Il. V 892-896
:Hermes   myth:hasFather :Zeus ; myth:hasMother :Maia .          # Od. XIV 435
:Dionysus myth:hasFather :Zeus ; myth:hasMother :Semele .        # Il. XIV 323-325
:Heracles myth:hasFather :Zeus ; myth:hasMother :Alcmene .       # Il. XIV 323-324; XIX 98-99
:Persephone myth:hasFather :Zeus .                               # Od. XI 217
:Helen    myth:hasFather :Zeus .                                 # Il. III 418, 426
:Sarpedon myth:hasFather :Zeus ; myth:hasMother :Laodamia ;      # Il. VI 198-199
          myth:rulesOver :Lycia .

:Hades myth:hasSpouse :Persephone .

:BirthOfHeracles a myth:Birth ;
    rdfs:label "Era ritarda la nascita di Eracle"@it, "Hera delays the birth of Heracles"@en ;
    myth:hasParticipant :Heracles, :Hera, :Alcmene ; myth:setIn :Thebes ;
    myth:attestedIn :Il_XIX_95_133 .

# Od. XI 601-604: Eracle tra gli dei, sposo di Ebe
:Heracles myth:hasSpouse :Hebe .

# achille
:Achilles myth:hasFather :Peleus ; myth:hasMother :Thetis .      # Il. I 1; I 351-360
:Thetis   myth:hasFather :Nereus .                               # Il. I 358 ("il vecchio padre")
:Peleus   myth:hasFather :Aeacus ; myth:hasSpouse :Thetis .     # Il. XXI 189
:Aeacus   myth:hasFather :Zeus .                                 # Il. XXI 189
:Patroclus myth:hasFather :Menoetius .

# troia
:Priam  myth:hasSpouse :Hecuba ; myth:rulesOver :Troy .
:Hector myth:hasFather :Priam ; myth:hasMother :Hecuba ; myth:hasSpouse :Andromache .
:Paris  myth:hasFather :Priam .
:Helen  myth:hasSpouse :Menelaus .

:TrojanWar a myth:War ;
    rdfs:label "Guerra di Troia"@it, "Trojan War"@en ;
    myth:setIn :Troy ;
    myth:hasParticipant :Achilles, :Patroclus, :Hector, :Paris, :Menelaus, :Odysseus,
                        :Sarpedon, :Priam, :Athena, :Hera, :Apollo, :Ares, :Aphrodite, :Poseidon ;
    myth:attestedIn :Il_I_1_10 .

:Patroclus myth:killed :Sarpedon .                               # Il. XVI 480-505
:Hector    myth:killed :Patroclus .                              # Il. XVI 818-857
:Achilles  myth:killed :Hector .                                 # Il. XXII 326-363

:claim_hom_achilles_kills_hector a rdf:Statement ;
    rdf:subject :Achilles ; rdf:predicate myth:killed ; rdf:object :Hector ;
    myth:attestedIn :Il_XXII_326_363 .

# odissea
:Odysseus  myth:hasFather :Laertes ; myth:hasSpouse :Penelope ; myth:rulesOver :Ithaca .
:Telemachus myth:hasFather :Odysseus ; myth:hasMother :Penelope .

# Od. I 68-73
:Polyphemus myth:hasFather :Poseidon ; myth:hasMother :Thoosa .
:Thoosa     myth:hasFather :Phorcys .

:BlindingOfPolyphemus a myth:HeroicDeed ;
    rdfs:label "Odisseo acceca Polifemo"@it, "Odysseus blinds Polyphemus"@en ;
    myth:hasAgent :Odysseus ; myth:hasPatient :Polyphemus ;
    myth:setIn :LandOfCyclopes ;
    myth:attestedIn :Od_IX_371_394 .

:PassageOfScyllaAndCharybdis a myth:HeroicDeed ;
    rdfs:label "Odisseo passa tra Scilla e Cariddi"@it, "Odysseus passes Scylla and Charybdis"@en ;
    myth:hasAgent :Odysseus ; myth:hasParticipant :Scylla, :Charybdis ;
    myth:setIn :StraitOfScylla ;
    myth:attestedIn :Od_XII_234_259 .

:CattleOfHelios a myth:Event ;
    rdfs:label "I compagni di Odisseo uccidono le vacche del Sole"@it, "The cattle of Helios"@en ;
    myth:hasParticipant :Odysseus, :Helios, :Zeus ;
    myth:setIn :Thrinacia ;
    myth:attestedIn :Od_XII_260_419 .
