# Esiodo, Teogonia -> grafo g:hesiod
# versi secondo la numerazione standard (ed. West)

@prefix :        <https://example.org/mythograph/resource/> .
@prefix myth:    <https://example.org/mythograph/ontology#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

# passi citati
:Theog_116_123 a myth:Passage ; myth:inWork :Theogony ; myth:locus "vv. 116-123" ; rdfs:label "Teogonia, vv. 116-123"@it .
:Theog_126_138 a myth:Passage ; myth:inWork :Theogony ; myth:locus "vv. 126-138" ; rdfs:label "Teogonia, vv. 126-138"@it .
:Theog_139_153 a myth:Passage ; myth:inWork :Theogony ; myth:locus "vv. 139-153" ; rdfs:label "Teogonia, vv. 139-153"@it .
:Theog_154_182 a myth:Passage ; myth:inWork :Theogony ; myth:locus "vv. 154-182" ; rdfs:label "Teogonia, vv. 154-182"@it .
:Theog_188_206 a myth:Passage ; myth:inWork :Theogony ; myth:locus "vv. 188-206" ; rdfs:label "Teogonia, vv. 188-206"@it .
:Theog_233_244 a myth:Passage ; myth:inWork :Theogony ; myth:locus "vv. 233-244" ; rdfs:label "Teogonia, vv. 233-244"@it .
:Theog_270_294 a myth:Passage ; myth:inWork :Theogony ; myth:locus "vv. 270-294" ; rdfs:label "Teogonia, vv. 270-294"@it .
:Theog_306_332 a myth:Passage ; myth:inWork :Theogony ; myth:locus "vv. 306-332" ; rdfs:label "Teogonia, vv. 306-332"@it .
:Theog_337_411 a myth:Passage ; myth:inWork :Theogony ; myth:locus "vv. 337-411" ; rdfs:label "Teogonia, vv. 337-411"@it .
:Theog_453_506 a myth:Passage ; myth:inWork :Theogony ; myth:locus "vv. 453-506" ; rdfs:label "Teogonia, vv. 453-506"@it .
:Theog_507_531 a myth:Passage ; myth:inWork :Theogony ; myth:locus "vv. 507-531" ; rdfs:label "Teogonia, vv. 507-531"@it .
:Theog_617_720 a myth:Passage ; myth:inWork :Theogony ; myth:locus "vv. 617-720" ; rdfs:label "Teogonia, vv. 617-720"@it .
:Theog_820_868 a myth:Passage ; myth:inWork :Theogony ; myth:locus "vv. 820-868" ; rdfs:label "Teogonia, vv. 820-868"@it .
:Theog_886_929 a myth:Passage ; myth:inWork :Theogony ; myth:locus "vv. 886-929" ; rdfs:label "Teogonia, vv. 886-929"@it .
:Theog_930_955 a myth:Passage ; myth:inWork :Theogony ; myth:locus "vv. 930-955" ; rdfs:label "Teogonia, vv. 930-955"@it .
:Theog_975_1007 a myth:Passage ; myth:inWork :Theogony ; myth:locus "vv. 975-1007" ; rdfs:label "Teogonia, vv. 975-1007"@it .

# origini (vv. 116-138)
# Eros primordiale, senza genitori (in Ovidio è figlio di Venere)
:Eros a myth:Primordial ;
    a [ a owl:Restriction ; owl:onProperty myth:hasParent ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger ] .

:Erebus myth:hasParent :Chaos .
:Nyx    myth:hasParent :Chaos .

# Gea genera Urano e Ponto da sola.
:Uranus myth:hasMother :Gaia .
:Pontus myth:hasMother :Gaia .
:Gaia   myth:hasSpouse :Uranus .

# I dodici Titani: figli di Gea e Urano (vv. 133-138).
:Oceanus   myth:hasFather :Uranus ; myth:hasMother :Gaia .
:Coeus     myth:hasFather :Uranus ; myth:hasMother :Gaia .
:Crius     myth:hasFather :Uranus ; myth:hasMother :Gaia .
:Hyperion  myth:hasFather :Uranus ; myth:hasMother :Gaia .
:Iapetus   myth:hasFather :Uranus ; myth:hasMother :Gaia .
:Theia     myth:hasFather :Uranus ; myth:hasMother :Gaia .
:Rhea      myth:hasFather :Uranus ; myth:hasMother :Gaia .
:Themis    myth:hasFather :Uranus ; myth:hasMother :Gaia .
:Mnemosyne myth:hasFather :Uranus ; myth:hasMother :Gaia .
:Phoebe    myth:hasFather :Uranus ; myth:hasMother :Gaia .
:Tethys    myth:hasFather :Uranus ; myth:hasMother :Gaia .
:Cronus    myth:hasFather :Uranus ; myth:hasMother :Gaia .

# Ciclopi e Centimani: anch'essi figli di Gea e Urano (vv. 139-153).
# (i Ciclopi di Omero sono altri: Polifemo è figlio di Poseidone)
:Brontes  myth:hasFather :Uranus ; myth:hasMother :Gaia .
:Steropes myth:hasFather :Uranus ; myth:hasMother :Gaia .
:Arges    myth:hasFather :Uranus ; myth:hasMother :Gaia .
:Briareus myth:hasFather :Uranus ; myth:hasMother :Gaia .

# la castrazione di urano
:CastrationOfUranus a myth:Event ;
    rdfs:label "Evirazione di Urano"@it, "Castration of Uranus"@en ;
    myth:hasAgent :Cronus ; myth:hasPatient :Uranus ;
    myth:attestedIn :Theog_154_182 .

# nascita di afrodite (vv. 188-206)
# nasce dalla spuma intorno ai genitali di Urano: padre Urano, nessuna madre.
# la madre va esclusa esplicitamente (mondo aperto)
:Aphrodite myth:hasFather :Uranus ;
    myth:bornIn :Cyprus ;
    a [ a owl:Restriction ; owl:onProperty myth:hasMother ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger ] .

:BirthOfAphrodite a myth:Birth ;
    rdfs:label "Nascita di Afrodite dalla spuma"@it, "Birth of Aphrodite from the foam"@en ;
    myth:hasParticipant :Aphrodite, :Uranus ;
    myth:setIn :Cyprus ;
    myth:attestedIn :Theog_188_206 .

# reificazione: il passo che attesta il padre
:claim_hes_aphrodite_father a rdf:Statement ;
    rdf:subject :Aphrodite ; rdf:predicate myth:hasFather ; rdf:object :Uranus ;
    myth:attestedIn :Theog_188_206 .

# stirpe di ponto (vv. 233-294)
:Nereus  myth:hasFather :Pontus ; myth:hasMother :Gaia .
:Phorcys myth:hasFather :Pontus ; myth:hasMother :Gaia .
:Ceto    myth:hasFather :Pontus ; myth:hasMother :Gaia .

:Thetis  myth:hasFather :Nereus ; myth:hasMother :Doris .      # una delle Nereidi (v. 244)
:Medusa  myth:hasFather :Phorcys ; myth:hasMother :Ceto .      # la Gorgone mortale (vv. 276-277)

# Da Medusa decapitata nascono Pegaso e Crisaore; il padre è Poseidone (vv. 278-281).
:Pegasus  myth:hasFather :Poseidon ; myth:hasMother :Medusa .
:Chrysaor myth:hasFather :Poseidon ; myth:hasMother :Medusa .
:Geryon   myth:hasFather :Chrysaor .

:SlayingOfMedusa a myth:HeroicDeed ;
    rdfs:label "Perseo decapita Medusa"@it, "Perseus beheads Medusa"@en ;
    myth:hasAgent :Perseus ; myth:hasPatient :Medusa ;
    myth:attestedIn :Theog_270_294 .
:Perseus myth:killed :Medusa .

# mostri (vv. 306-332, 820-822)
:Typhon   myth:hasFather :Tartarus ; myth:hasMother :Gaia .
:Hydra    myth:hasFather :Typhon ; myth:hasMother :Echidna .
:Cerberus myth:hasFather :Typhon ; myth:hasMother :Echidna .

# fatiche di eracle
:Labour_Hydra a myth:Labour ;
    rdfs:label "Eracle uccide l'Idra di Lerna"@it, "Heracles slays the Hydra"@en ;
    myth:hasAgent :Heracles ; myth:hasPatient :Hydra ; myth:setIn :Lerna ;
    myth:attestedIn :Theog_306_332 .
:Labour_NemeanLion a myth:Labour ;
    rdfs:label "Eracle uccide il leone di Nemea"@it, "Heracles slays the Nemean lion"@en ;
    myth:hasAgent :Heracles ; myth:hasPatient :NemeanLion ; myth:setIn :Nemea ;
    myth:attestedIn :Theog_306_332 .
:Labour_Geryon a myth:Labour ;
    rdfs:label "Eracle uccide Gerione"@it, "Heracles slays Geryon"@en ;
    myth:hasAgent :Heracles ; myth:hasPatient :Geryon ; myth:setIn :Erytheia ;
    myth:attestedIn :Theog_270_294 .
:FreeingOfPrometheus a myth:HeroicDeed ;
    rdfs:label "Eracle libera Prometeo uccidendo l'aquila"@it, "Heracles frees Prometheus"@en ;
    myth:hasAgent :Heracles ; myth:hasParticipant :Prometheus ;
    myth:attestedIn :Theog_507_531 .

:Heracles myth:killed :Hydra, :NemeanLion, :Geryon .

# oceanine e titani (vv. 337-411, 507-511)
:Metis   myth:hasFather :Oceanus ; myth:hasMother :Tethys .
:Clymene myth:hasFather :Oceanus ; myth:hasMother :Tethys .
:Doris   myth:hasFather :Oceanus ; myth:hasMother :Tethys .
# In Esiodo Dione è un'Oceanina (v. 353). In Omero è la madre di Afrodite.
:Dione   myth:hasFather :Oceanus ; myth:hasMother :Tethys .

:Helios myth:hasFather :Hyperion ; myth:hasMother :Theia .
:Selene myth:hasFather :Hyperion ; myth:hasMother :Theia .
:Eos    myth:hasFather :Hyperion ; myth:hasMother :Theia .

:Leto    myth:hasFather :Coeus ; myth:hasMother :Phoebe .
:Asteria myth:hasFather :Coeus ; myth:hasMother :Phoebe .
:Hecate  myth:hasMother :Asteria .

:Atlas      myth:hasFather :Iapetus ; myth:hasMother :Clymene .
:Prometheus myth:hasFather :Iapetus ; myth:hasMother :Clymene .
:Epimetheus myth:hasFather :Iapetus ; myth:hasMother :Clymene .

# figli di crono e rea (vv. 453-506)
:Cronus myth:hasSpouse :Rhea .
:Hestia   myth:hasFather :Cronus ; myth:hasMother :Rhea .
:Demeter  myth:hasFather :Cronus ; myth:hasMother :Rhea .
:Hera     myth:hasFather :Cronus ; myth:hasMother :Rhea .
:Hades    myth:hasFather :Cronus ; myth:hasMother :Rhea .
:Poseidon myth:hasFather :Cronus ; myth:hasMother :Rhea .
:Zeus     myth:hasFather :Cronus ; myth:hasMother :Rhea ;
    myth:bornIn :Lyctus .

:BirthOfZeus a myth:Birth ;
    rdfs:label "Nascita di Zeus a Creta"@it, "Birth of Zeus in Crete"@en ;
    myth:hasParticipant :Zeus, :Rhea ; myth:setIn :Lyctus ;
    myth:attestedIn :Theog_453_506 .

# guerre cosmiche
:Titanomachy a myth:War ;
    rdfs:label "Titanomachia"@it, "Titanomachy"@en ;
    myth:hasParticipant :Zeus, :Cronus, :Iapetus, :Hyperion, :Briareus ;
    myth:attestedIn :Theog_617_720 .

:Typhonomachy a myth:War ;
    rdfs:label "Lotta tra Zeus e Tifone"@it, "Typhonomachy"@en ;
    myth:hasAgent :Zeus ; myth:hasPatient :Typhon ;
    myth:attestedIn :Theog_820_868 .

# le nozze di zeus (vv. 886-929)
:Zeus myth:hasSpouse :Metis, :Themis, :Demeter, :Mnemosyne, :Leto, :Hera .

# Atena: figlia di Zeus e di Metide, che Zeus aveva inghiottito; nasce dalla testa.
:Athena myth:hasFather :Zeus ; myth:hasMother :Metis .
:BirthOfAthena a myth:Birth ;
    rdfs:label "Nascita di Atena dalla testa di Zeus"@it, "Birth of Athena from Zeus' head"@en ;
    myth:hasParticipant :Athena, :Zeus, :Metis ;
    myth:attestedIn :Theog_886_929 .

:Persephone myth:hasFather :Zeus ; myth:hasMother :Demeter .
:Apollo     myth:hasFather :Zeus ; myth:hasMother :Leto .
:Artemis    myth:hasFather :Zeus ; myth:hasMother :Leto .
:Hebe       myth:hasFather :Zeus ; myth:hasMother :Hera .
:Ares       myth:hasFather :Zeus ; myth:hasMother :Hera .
:Eileithyia myth:hasFather :Zeus ; myth:hasMother :Hera .
:Hermes     myth:hasFather :Zeus ; myth:hasMother :Maia .
:Dionysus   myth:hasFather :Zeus ; myth:hasMother :Semele .     # madre mortale (vv. 940-942)
:Heracles   myth:hasFather :Zeus ; myth:hasMother :Alcmene .    # vv. 943-944

# Efesto: Era lo genera da sola (vv. 927-929), quindi nessun padre
:Hephaestus myth:hasMother :Hera ;
    a [ a owl:Restriction ; owl:onProperty myth:hasFather ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger ] .

:claim_hes_hephaestus_fatherless a rdf:Statement ;
    rdf:subject :Hephaestus ; rdf:predicate myth:hasMother ; rdf:object :Hera ;
    myth:attestedIn :Theog_886_929 ;
    myth:versionNote "Era genera Efesto senza unirsi a Zeus."@it .

:Hades myth:hasSpouse :Persephone .

# altre nozze (vv. 930-955)
:Poseidon myth:hasSpouse :Amphitrite .
:Triton   myth:hasFather :Poseidon ; myth:hasMother :Amphitrite .

:Harmonia myth:hasFather :Ares ; myth:hasMother :Aphrodite .
:Hephaestus myth:hasSpouse :Aglaea .          # la più giovane delle Cariti
:Dionysus myth:hasSpouse :Ariadne .
# dopo le fatiche sposa Ebe e vive tra gli immortali (TODO: apoteosi)
:Heracles myth:hasSpouse :Hebe .

# eroi (vv. 975-1007)
:Cadmus myth:hasSpouse :Harmonia .
:Semele myth:hasFather :Cadmus ; myth:hasMother :Harmonia .
:Peleus myth:hasSpouse :Thetis .
:Achilles myth:hasFather :Peleus ; myth:hasMother :Thetis .
